# ── Plantilla de variables de contorno ────────────────────────
#
# Copia este ficheiro como .env.local e pon os valores reais.
# .env.local está no .gitignore e NUNCA se sobe a GitHub.
#
# Onde atopar os valores:
#   Supabase Dashboard → Project Settings → API
#
# En Vercel hai que configuralos á parte:
#   Vercel → Settings → Environment Variables
#
# Nota: a ANON_KEY é pública por deseño (vai no bundle que se
# serve ao navegador). O que nunca debe aparecer aquí nin no
# repo é a SERVICE ROLE KEY.
# ──────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
